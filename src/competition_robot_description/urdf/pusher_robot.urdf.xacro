<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pusher_robot">
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*r*r/2}" iyz="0" izz="${m*(3*r*r+h*h)/12}"/>
  </xacro:macro>
  <material name="chassis_blue"><color rgba="0.12 0.25 0.48 1"/></material>
  <material name="dark"><color rgba="0.07 0.08 0.10 1"/></material>
  <material name="silver"><color rgba="0.62 0.67 0.70 1"/></material>
  <link name="base_footprint"/>
  <joint name="base_fixed" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.14"/></joint>
  <link name="base_link">
    <inertial><mass value="3.2"/><origin xyz="0 0 0"/><xacro:box_inertia m="3.2" x="0.40" y="0.30" z="0.20"/></inertial>
    <visual><geometry><box size="0.40 0.30 0.20"/></geometry><material name="chassis_blue"/></visual>
    <collision><geometry><box size="0.40 0.30 0.20"/></geometry></collision>
  </link>
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <inertial><mass value="0.25"/><origin xyz="0 0 0"/><xacro:cylinder_inertia m="0.25" r="0.05" h="0.035"/></inertial>
      <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.05" length="0.035"/></geometry><material name="dark"/></visual>
      <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.05" length="0.035"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel_link"/><origin xyz="-0.05 ${y} -0.09"/><axis xyz="0 1 0"/></joint>
    <gazebo reference="${side}_wheel_link"><mu1>0.9</mu1><mu2>0.9</mu2></gazebo>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="0.15"/>
  <xacro:drive_wheel side="right" y="-0.15"/>
  <link name="caster_swivel_link">
    <inertial><mass value="0.06"/><origin xyz="-0.02 0 -0.025"/><xacro:box_inertia m="0.06" x="0.02" y="0.015" z="0.035"/></inertial>
    <visual><origin xyz="-0.02 0 -0.025"/><geometry><box size="0.02 0.015 0.035"/></geometry><material name="silver"/></visual>
    <collision><origin xyz="-0.02 0 -0.025"/><geometry><box size="0.02 0.015 0.035"/></geometry></collision>
  </link>
  <joint name="caster_swivel_joint" type="continuous"><parent link="base_link"/><child link="caster_swivel_link"/><origin xyz="0.16 0 -0.065"/><axis xyz="0 0 1"/></joint>
  <link name="caster_link">
    <inertial><mass value="0.10"/><origin xyz="0 0 0"/><xacro:cylinder_inertia m="0.10" r="0.025" h="0.018"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.025" length="0.018"/></geometry><material name="dark"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.025" length="0.018"/></geometry></collision>
  </link>
  <joint name="caster_roll_joint" type="continuous"><parent link="caster_swivel_link"/><child link="caster_link"/><origin xyz="-0.02 0 -0.05"/><axis xyz="0 1 0"/></joint>
  <gazebo reference="caster_link"><mu1>0.10</mu1><mu2>0.10</mu2></gazebo>
  <link name="pusher_link">
    <inertial><mass value="0.25"/><origin xyz="0 0 0"/><xacro:box_inertia m="0.25" x="0.025" y="0.24" z="0.07"/></inertial>
    <visual><geometry><box size="0.025 0.24 0.07"/></geometry><material name="silver"/></visual>
    <collision><geometry><box size="0.025 0.24 0.07"/></geometry></collision>
  </link>
  <joint name="pusher_joint" type="fixed"><parent link="base_link"/><child link="pusher_link"/><origin xyz="0.225 0 -0.065"/></joint>
  <xacro:macro name="pusher_wing" params="side y">
    <link name="pusher_wing_${side}">
      <inertial><mass value="0.05"/><origin xyz="0 0 0"/><xacro:box_inertia m="0.05" x="0.07" y="0.02" z="0.07"/></inertial>
      <visual><geometry><box size="0.07 0.02 0.07"/></geometry><material name="silver"/></visual>
      <collision><geometry><box size="0.07 0.02 0.07"/></geometry></collision>
    </link>
    <joint name="pusher_wing_${side}_joint" type="fixed"><parent link="pusher_link"/><child link="pusher_wing_${side}"/><origin xyz="0.0475 ${y} 0"/></joint>
    <gazebo reference="pusher_wing_${side}"><material>Gazebo/Grey</material></gazebo>
  </xacro:macro>
  <xacro:pusher_wing side="left" y="0.12"/>
  <xacro:pusher_wing side="right" y="-0.12"/>
  <link name="lidar_link">
    <inertial><mass value="0.10"/><origin xyz="0 0 0"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.015"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.11"/></joint>
  <link name="camera_link">
    <inertial><mass value="0.08"/><origin xyz="0 0 0"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
    <visual><geometry><box size="0.025 0.045 0.035"/></geometry><material name="dark"/></visual>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.205 0 0.055" rpy="0 0.20 0"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="-1.57079632679 0 -1.57079632679"/></joint>
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="pusher_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar"><pose>0 0 0 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><always_on>true</always_on><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan><range><min>0.08</min><max>8.0</max><resolution>0.01</resolution></range></lidar></sensor>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera"><pose>0 0 0 0 0 0</pose><topic>/camera/image</topic><update_rate>15</update_rate><always_on>true</always_on><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>8.0</far></clip></camera></sensor>
  </gazebo>
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.30</wheel_separation><wheel_radius>0.05</wheel_radius><topic>/model/pusher_robot/cmd_vel</topic><odom_topic>/odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><odom_publish_frequency>30</odom_publish_frequency><max_linear_velocity>0.8</max_linear_velocity><min_linear_velocity>-0.8</min_linear_velocity><max_angular_velocity>1.5</max_angular_velocity><min_angular_velocity>-1.5</min_angular_velocity><max_linear_acceleration>1.0</max_linear_acceleration><min_linear_acceleration>-1.0</min_linear_acceleration><max_angular_acceleration>2.0</max_angular_acceleration><min_angular_acceleration>-2.0</min_angular_acceleration></plugin>
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher"><topic>/joint_states</topic><joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name><joint_name>caster_swivel_joint</joint_name><joint_name>caster_roll_joint</joint_name></plugin>
  </gazebo>
</robot>
